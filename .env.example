# ===== Kendle learnAI — biến môi trường =====
# Sao chép file này thành .env khi chạy local.
# Trên Hostinger: nhập các biến này trong hPanel > Node.js app > Environment variables.

NODE_ENV=production
PORT=3000
SITE_URL=https://kendlelearnai.com

# Email hiển thị trên trang Liên hệ
CONTACT_EMAIL=hello@kendlelearnai.com

# SMTP (email Hostinger: smtp.hostinger.com, cổng 465, SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@kendlelearnai.com
SMTP_PASS=
MAIL_FROM=hello@kendlelearnai.com
MAIL_TO=hello@kendlelearnai.com

# Mạng xã hội (để trống nếu chưa có)
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_LINKEDIN=
SOCIAL_GITHUB=
